{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "configVersion": "2.0.0",
  "id": "web-utils",
  "version": "1.0.0",
  "additionalData": {
    "description": "Quest HTTP utilities using shared libcurl",
    "author": "RedBrumbler",
    "license": "",
    "url": "https://github.com/bsq-ports/WebUtils"
  },
  "workspace": {
    "scripts": {
      "build": [
        "cmake -S . -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "cmake --build build --parallel 4",
        "cmake -E make_directory extern/build/build",
        "cmake -E copy build/libweb-utils.so extern/build/build/libweb-utils.so"
      ]
    },
    "ndk": "^27.3.13750724",
    "outBinaries": [
      "build/libweb-utils.so"
    ],
    "toolchainOut": null,
    "cmake": false
  },
  "qmod": {
    "template": "mod.template.json",
    "output": "WebUtils.qmod",
    "searchDirs": ["build"],
    "includeFiles": [],
    "id": "web-utils"
  },
  "dependencies": {
    "libcurl": {
      "versionRange": "^8.23.0",
      "qmod": "required"
    }
  },
  "devDependencies": {
    "fmt": {
      "versionRange": "^12.2.1"
    }
  },
  "dependenciesDirectory": "extern",
  "sharedDirectory": "shared",
  "compileOptions": {
    "includePaths": [
      ""
    ]
  }
}
